# Copy to .env.local and fill in. Values for local development are printed by `npx supabase start`.

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# AI providers (used from feature 008 onwards)
GEMINI_API_KEY=
GROQ_API_KEY=
# Vision + JSON capable model; confirm model and free-tier quota on demo day
GEMINI_MODEL=
# Optional text-only fallback model
GROQ_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# Demo accounts (feature 001). DEMO_ACCOUNT_PASSWORD must equal the password in supabase/seed.sql.
DEMO_ACCOUNTS_ENABLED=true
DEMO_ACCOUNT_PASSWORD=suryamit-demo-2026
